# Copy to .env and fill in real values. .env is gitignored and must never be committed.
# The API refuses to start if the JWT key is missing, still a placeholder, or shorter
# than 32 characters.

# --- Local Postgres (docker compose) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=fitness_tracker
DB_USER=fitness
DB_PASSWORD=CHANGE_ME

# --- JWT signing secret: generate with `openssl rand -hex 32` ---
JWT_KEY=CHANGE_ME

# --- Optional: seeds an Admin account on first start. Set both or neither. ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
